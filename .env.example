# Copy this file to .env.local through scripts/dev.ps1. Never commit .env.local.
COMPOSE_PROJECT_NAME=regontology

# Published local ports are bound to loopback by default.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
NEO4J_BIND_ADDRESS=127.0.0.1
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379

# Local data-service credentials. scripts/dev.ps1 replaces CHANGE_ME values
# with URL-safe random values when it creates .env.local.
POSTGRES_DB=regontology
POSTGRES_USER=regontology_app
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Application profile. fake is deterministic and does not require an API key.
REGONTOLOGY_ENV=development
REGONTOLOGY_DEMO_AUTH_ENABLED=true
REGONTOLOGY_AI_PROVIDER=fake
REGONTOLOGY_REPOSITORY_MODE=postgres
REGONTOLOGY_GRAPH_MODE=neo4j
REGONTOLOGY_AUTO_SEED_MOCK_DATA=false
REGONTOLOGY_MOCK_DATA_DIR=/app/mock-data
REGONTOLOGY_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
REGONTOLOGY_OPENAI_MODEL=gpt-5-mini
REGONTOLOGY_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Frontend build-time API base. Keep this relative when nginx proxies the API.
VITE_API_BASE_URL=/api/v1
# Docker/GHCR builds must surface API failures instead of using embedded demo data.
VITE_DEMO_MODE=false

# Local image names. CI publishes the same components to GHCR.
API_IMAGE=ghcr.io/begop/regontology-api:local
WEB_IMAGE=ghcr.io/begop/regontology-web:local

# Version-pinned local infrastructure images.
PGVECTOR_IMAGE=pgvector/pgvector:0.8.6-pg16-bookworm
NEO4J_IMAGE=neo4j:5.26.29-community
REDIS_IMAGE=redis:7.4.11-alpine
