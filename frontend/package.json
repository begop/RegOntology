{
  "name": "regontology-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner && vite build --config vite.worker.config.ts --configLoader runner && node scripts/verify-worker.mjs",
    "build:pages": "tsc -b && vite build --configLoader runner && node scripts/create-pages-fallback.mjs",
    "preview": "vite preview --host 0.0.0.0 --configLoader runner",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts --configLoader runner",
    "test:watch": "vitest --config vitest.config.ts --configLoader runner"
  },
  "dependencies": {
    "@tanstack/react-query": "5.85.5",
    "cytoscape": "3.33.1",
    "lucide-react": "0.541.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.8.2"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "0.2.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/cytoscape": "3.21.9",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@11.19.0"
}
